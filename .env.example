# Copy this file to .env for local use. On Vercel, set these in
# Project Settings -> Environment Variables instead. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key-here

# Gemini model ID, copied from the model list in Google AI Studio.
# Example format (check the list for a current name): gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash
